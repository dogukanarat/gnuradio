options:
  parameters:
    id: scopes
    title: Scope demo
    generate_options: qt_gui
    output_language: python
    author: ''
    category: '[GRC Hier Blocks]'
    placement: (0,0)
    run: 'True'
    run_options: prompt
    window_size: (1200,900)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 20
    - 20
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 20
    rotation: 0
    state: enabled
- name: sig
  id: analog_sig_source_x
  parameters:
    amp: '1'
    freq: '2000'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: analog.GR_COS_WAVE
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 20
    - 140
    rotation: 0
    state: enabled
- name: chirp
  id: analog_sig_source_x
  parameters:
    amp: '0.5'
    freq: '-6000'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: analog.GR_COS_WAVE
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 20
    - 330
    rotation: 0
    state: enabled
- name: noise
  id: analog_noise_source_x
  parameters:
    amp: '0.3'
    noise_type: analog.GR_GAUSSIAN
    seed: '0'
    type: complex
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 20
    - 520
    rotation: 0
    state: enabled
- name: add
  id: blocks_add_xx
  parameters:
    num_inputs: '3'
    type: complex
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 340
    rotation: 0
    state: enabled
- name: thr
  id: blocks_throttle2
  parameters:
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 420
    - 330
    rotation: 0
    state: enabled
- name: time_sink
  id: qtgui_time_sink_x
  parameters:
    type: complex
    name: '''Time'''
    size: '512'
    srate: samp_rate
    nconnections: '1'
    autoscale: 'False'
    ymin: '-2'
    ymax: '2'
    grid: 'True'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 120
    rotation: 0
    state: enabled
- name: freq_sink
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '''Spectrum'''
    fftsize: '1024'
    bw: samp_rate
    fc: '0'
    nconnections: '1'
    grid: 'True'
    average: '0.2'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 330
    rotation: 0
    state: enabled
- name: waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    type: complex
    name: '''Waterfall'''
    fftsize: '1024'
    bw: samp_rate
    fc: '0'
    nconnections: '1'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 540
    rotation: 0
    state: enabled
connections:
- - sig
  - '0'
  - add
  - '0'
- - chirp
  - '0'
  - add
  - '1'
- - noise
  - '0'
  - add
  - '2'
- - add
  - '0'
  - thr
  - '0'
- - thr
  - '0'
  - time_sink
  - '0'
- - thr
  - '0'
  - freq_sink
  - '0'
- - thr
  - '0'
  - waterfall
  - '0'
metadata:
  file_format: 1
  grc_version: '3.10'
